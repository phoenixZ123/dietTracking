//     name       String   @unique
//     users      User[] // relation, no onDelete here
//     created_at DateTime @default(now())
//     isActive   Boolean  @default(true)
// }

model User {
    id       String  @id @default(uuid())
    email    String? @unique
    phone_no String? @unique
    password String
    name     String
    // roleId   String
    // role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    profiles    Profile?
    dailyLogs   DailyLog[]
    workoutLogs WorkoutLog[]
    waterLogs   WaterLog[]
    weightLogs  WeightLog[]
    userSession UserSession?
    food        Food[]
}

model UserSession {
    id           String    @id @default(uuid())
    userId       String    @unique
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    refreshToken String
    device_type  String
    userAgent    String
    ipAddress    String?
    is_online    Boolean   @default(false)
    firebase_key String?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    last_seen    DateTime?
}

model Profile {
    id          String        @id @default(uuid())
    userId      String        @unique
    gender      Gender?
    birthDate   DateTime?
    heightCm    Float?
    weightKg    Float?
    goalWeight  Float?
    activityLvl ActivityLevel @default(MEDIUM)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyLog {
    id     String   @id @default(uuid())
    date   DateTime
    userId String

    user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    meals Meal[]
}

model Meal {
    id    String @id @default(uuid())
    name  String
    logId String

    dailyLog DailyLog   @relation(fields: [logId], references: [id], onDelete: Cascade)
    items    MealItem[]
}

model MealItem {
    id       String @id @default(uuid())
    mealId   String
    foodId   String
    quantity Float

    meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
    food Food @relation(fields: [foodId], references: [id])
}

model Exercise {
    id                   String   @id @default(uuid())
    name                 String
    caloriesBurnedPerMin Float
    created_at           DateTime @default(now())
    updated_at           DateTime @updatedAt

    workoutLogs WorkoutLog[]
}

model WorkoutLog {
    id          String   @id @default(uuid())
    date        DateTime
    userId      String
    exerciseId  String
    durationMin Float

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    exercise Exercise @relation(fields: [exerciseId], references: [id])
}

model WaterLog {
    id     String   @id @default(uuid())
    date   DateTime
    userId String
    amount Float

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeightLog {
    id       String   @id @default(uuid())
    date     DateTime
    userId   String
    weightKg Float

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Food {
    id          String   @id @default(uuid())
    name        String
    calories    Float
    protein     Float
    carbs       Float
    fat         Float
    servingSize Float
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    mealItems MealItem[]
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum ActivityLevel {
    LOW
    MEDIUM
    HIGH
}
